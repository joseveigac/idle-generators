{
  "schemaVersion": 1,
  "id": "idlegenerators",
  "version": "${version}",
  "name": "Idle Generators",
  "description": "Idle resource generators: place a generator and it produces resources over real time, even while the world is closed.",
  "authors": [
    "ghozix"
  ],
  "license": "All Rights Reserved",
  "icon": "assets/idlegenerators/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ghozix.idlegenerators.fabric.IdleGeneratorsFabric"
    ],
    "client": [
      "com.ghozix.idlegenerators.fabric.client.IdleGeneratorsFabricClient"
    ],
    "modmenu": [
      "com.ghozix.idlegenerators.fabric.IGModMenu"
    ],
    "fabric-gametest": [
      "com.ghozix.idlegenerators.fabric.gametest.IGGameTests"
    ],
    "fabric-datagen": [
      "com.ghozix.idlegenerators.fabric.datagen.IGDataGenerator"
    ],
    "jade": [
      "com.ghozix.idlegenerators.compat.jade.IGJadePlugin"
    ]
  },
  "mixins": [
    "idlegenerators.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "architectury": ">=21.0.2",
    "fabric-api": "*",
    "cloth-config": ">=26.2.155"
  },
  "suggests": {
    "modmenu": "*",
    "jade": "*"
  }
}
